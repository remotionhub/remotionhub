{
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "types": ["node", "vite/client"],
    "skipLibCheck": true,
    "target": "ESNext",
    "lib": ["ES2023", "dom"],
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["./**/*"],
  "exclude": ["./_generated"]
}
