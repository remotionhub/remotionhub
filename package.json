{
  "name": "my-tanstack-app",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude \"e2e/**\"",
    "coverage": "vitest run --coverage --exclude \"e2e/**\"",
    "catalog:validate": "tsx scripts/import-catalog.ts --dry-run --local-only",
    "catalog:import": "tsx scripts/import-catalog.ts",
    "test:e2e": "playwright test",
    "ci:unit": "npm run coverage",
    "ci:types-build": "tsc --noEmit && npm run build",
    "ci:playwright-smoke": "npm run build && npm run test:e2e",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@ai-sdk/openai": "2.0.74",
    "@auth/core": "^0.41.2",
    "@babel/standalone": "7.28.5",
    "@base-ui/react": "^1.5.0",
    "@convex-dev/auth": "^0.0.94",
    "@fontsource-variable/geist": "^5.2.9",
    "@react-three/fiber": "9.1.0",
    "@remotion/lottie": "4.0.487",
    "@remotion/player": "4.0.487",
    "@remotion/shapes": "4.0.487",
    "@remotion/three": "4.0.487",
    "@remotion/transitions": "4.0.487",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "ai": "5.0.104",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.42.1",
    "lucide-react": "^0.545.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remotion": "4.0.487",
    "semver": "^7.8.4",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "three": "0.178.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.43.0",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/ali-oss": "^6.23.3",
    "@types/babel__standalone": "7.1.9",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/semver": "^7.7.1",
    "@types/three": "0.176.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "ali-oss": "^6.23.0",
    "cheerio": "^1.2.0",
    "convex-test": "^0.0.53",
    "jsdom": "^28.1.0",
